# ==============================================================================
# CONFIGURACIÓN DEL RETO AGENTE 2026 (Platica.mx x Campuslands)
# ==============================================================================

# Llave asignada en el panel del reto (comienza con pk_...)
# NUNCA subas este archivo con tu llave real a GitHub.
RETO_API_KEY=pk_tu_llave_aqui

# Gateway espejo compatible con la API de OpenAI / xAI
RETO_BASE_URL=https://api.reto.pltk.mx/v1

# Modelo de razonamiento principal (grok-4.7, grok-4.6, grok-4.5)
GROK_MODEL=grok-4.7

# Modo de ejecución: "mock" (por defecto, $0 USD) o "live" (llamadas a la API real)
GROK_MODE=mock

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# CANAL WHATSAPP (Meta Cloud API / Sandbox)
# ==============================================================================
# Token de verificación para el handshake del Webhook en developers.facebook.com
WHATSAPP_VERIFY_TOKEN=sentinelguard_verify_2026

# Token de acceso temporal o permanente generado en Meta Developer Portal
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID del remitente de pruebas en Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=

# Versión de Graph API de Meta
WHATSAPP_API_VERSION=v20.0
